@startuml
hide footbox
autonumber
skinparam BoxPadding 20

box Data holder organisation
participant XIS as req
participant "Nuts-node" as rn
end box

box Discovery Service organisation
participant "Nuts-node\n(Discovery Service)" as dn
end box

req -> rn: POST /internal/discovery/v1/{serviceID}/{subjectID of Data holder organisation}
rn <--> dn : nuts-nodes handle registration request
rn -> req: 200
@enduml
