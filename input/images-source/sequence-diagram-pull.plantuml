@startuml
hide footbox
autonumber
skinparam BoxPadding 20

box Data user organisation `A`\n
actor "Healthcare professional" as User
participant XIS as req
participant "Nuts-node" as rn
end box


box Data holder organisation `B`\n
participant "Nuts-node" as cn
boundary PEP
participant Fhir
end box
User -> req++ : Log in
req -> req : Create user session

== Later in User session ==

User -> req: request information for Patient
    req -> req: Resolve Patient BSN\nand data_holder_URA's

    loop For each data_holder_URA

        ==get addresses of data holder organisation==

        req -> rn++: Look up data holder\norganisation by URA
            rn --> req --: authorization_server_url,\nfhir_base_url
        |||

        ==get access token==

        req -> rn++: Get access token
            rn <--> cn : Access token request
            rn --> req-- : Access token
        |||

        ==get Patient resource including patient-id==

        req -> PEP++: Patient search
        PEP -> cn++ : Introspect access token
        PEP <-- cn-- : Token info
        PEP -> PEP: Authorization
        PEP -> Fhir++: Patient search
        return Patient resource
        return Patient resource

        |||
        == Retrieve other resources ==

        loop For each resource type except Patient
            req -> PEP++: Resource request
                PEP -> cn++ : Introspect access token
                    PEP <-- cn-- : Token info
                PEP -> PEP: Authorization
                PEP -> Fhir++: Resource request
                return Resources
                return Resources
        end loop

    end loop

    ==Data user XIS displays data received from data holder(s)==

    User <- req --: Display external Patient information

@enduml
